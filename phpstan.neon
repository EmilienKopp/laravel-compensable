includes:
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    
parameters:
    level: 5
    paths:
        - src

    reportUnmatchedIgnoredErrors: true

    ignoreErrors:
        # Consumer-facing traits: meant to be mixed into the package user's
        # own classes, so they're never used within src/ itself.
        - identifier: trait.unused